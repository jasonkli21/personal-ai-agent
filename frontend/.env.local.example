# Used only by server-side Next.js routes; it is not sent to the browser.
API_BASE_URL=http://localhost:8000

# Enable only locally, together with the matching backend flag.
CONTEXT_INSPECTION_ENABLED=false

# Independently gates supplied-memory planning in the development inspector.
MEMORY_INSPECTION_ENABLED=false
MEMORY_LIFECYCLE_INSPECTION_ENABLED=false

# Phase 5 page and proxy; backend must also be enabled deliberately.
RESEARCH_ENABLED=false
RESEARCH_INSPECTION_ENABLED=false

# Phase 6 results and development-only candidate/policy inspection.
DECISION_ENABLED=false
DECISION_INSPECTION_ENABLED=false
TRAVEL_ENABLED=false
SHOPPING_ENABLED=false
DOMAIN_INSPECTION_ENABLED=false
TRAVEL_PLACES_ADAPTER=fake
SHOPPING_PRODUCTS_ADAPTER=fake
