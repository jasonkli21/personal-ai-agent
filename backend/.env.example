# Use a local provider setting during development; never commit real secrets.
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
AI_API_KEY=
FIRESTORE_PROJECT_ID=example-personal-ai
FIRESTORE_EMULATOR_HOST=localhost:8080
REQUEST_TIMEOUT_SECONDS=30
# Application ceilings; verify compatibility whenever AI_MODEL changes.
MAX_CONTEXT_TOKENS=32768
MAX_RESPONSE_TOKENS=4096
CONTEXT_SAFETY_MARGIN_TOKENS=1024
SUMMARY_TRIGGER_TOKENS=12000
MAX_SUMMARY_TOKENS=2048
CONTEXT_INSPECTION_ENABLED=false
# JSON array required so multiple browser origins can be configured safely.
CORS_ORIGINS=["http://localhost:3000"]

# Optional external-search and domain-provider adapters. Leave unset until used.
SEARCH_PROVIDER=
SEARCH_API_KEY=
PLACES_API_KEY=
TRAVEL_API_KEY=

# Phase 3: enable only after reviewing provider-data suitability.
MEMORY_ENABLED=false
MEMORY_EXTRACTION_ENABLED=false
MEMORY_INSPECTION_ENABLED=false
MEMORY_EMBEDDING_MODEL=gemini-embedding-001
MEMORY_EMBEDDING_DIMENSIONS=768
MEMORY_EMBEDDING_BATCH_SIZE=8
MEMORY_MAX_CANDIDATES_PER_TURN=4
MEMORY_RETRIEVAL_CANDIDATE_LIMIT=20
MEMORY_RETRIEVAL_LIMIT=4
MEMORY_MIN_SIMILARITY=0.8
MEMORY_MAX_CONTEXT_TOKENS=512
MEMORY_TIMEOUT_SECONDS=5
# JSON array of additional denied terms, e.g. ["synthetic-private-term"]
MEMORY_SENSITIVE_TERMS=[]

# Phase 4 experiment controls. Lifecycle and inspection gates stay off by default.
MEMORY_EXPERIMENT_VARIANT=fixed
MEMORY_SCORING_POLICY_VERSION=score-v1
MEMORY_SCORE_SIMILARITY_WEIGHT=0.50
MEMORY_SCORE_IMPORTANCE_WEIGHT=0.15
MEMORY_SCORE_RECENCY_WEIGHT=0.15
MEMORY_SCORE_FREQUENCY_WEIGHT=0.10
MEMORY_SCORE_CONFIDENCE_WEIGHT=0.10
MEMORY_RECENCY_HALF_LIFE_DAYS=90
MEMORY_CONSOLIDATION_ENABLED=false
MEMORY_CONSOLIDATION_MAX_SOURCES=4
MEMORY_CONTRADICTION_AUTOMATION_ENABLED=false
MEMORY_FORGETTING_ENABLED=false
MEMORY_LIFECYCLE_WORKER_ENABLED=false
MEMORY_LIFECYCLE_INSPECTION_ENABLED=false
MEMORY_LIFECYCLE_TOPIC=personal-ai-async
MEMORY_JOB_MAX_ATTEMPTS=3
MEMORY_JOB_EXECUTION_SECONDS=30
MEMORY_JOB_LEASE_SECONDS=60
MEMORY_JOB_CANDIDATE_LIMIT=40

# Phase 5. Real search requires explicit storage/AI-use rights; see its guide.
RESEARCH_STORAGE=firestore
RESEARCH_ENABLED=false
RESEARCH_INSPECTION_ENABLED=false
RESEARCH_SEARCH_ADAPTER=fake
RESEARCH_PLANNER=deterministic
RESEARCH_RERANKER=deterministic
RESEARCH_PROVIDER_STORAGE_APPROVED=false
RESEARCH_API_KEY=
RESEARCH_MAX_QUERIES=1
RESEARCH_MAX_SOURCES=8
RESEARCH_MAX_RESPONSE_BYTES=131072
RESEARCH_MAX_REDIRECTS=0
RESEARCH_MAX_CONCURRENCY=1
RESEARCH_ATTEMPT_LIMIT=2
RESEARCH_EVIDENCE_TTL_GENERAL_SECONDS=86400
RESEARCH_EVIDENCE_TTL_CURRENT_SECONDS=3600
RESEARCH_MAX_EVIDENCE_CONTEXT_TOKENS=4096
RESEARCH_TIMEOUT_SECONDS=30
RESEARCH_PROVIDER_TIMEOUT_SECONDS=10
RESEARCH_MIN_REQUEST_INTERVAL_SECONDS=1
DECISION_ENABLED=false
DECISION_INSPECTION_ENABLED=false
ENTITY_RESOLUTION_POLICY_VERSION=resolve-v2
ENTITY_MATCH_THRESHOLD=0.9
DECISION_CONSTRAINT_POLICY_VERSION=constraint-v1
DECISION_RANKING_POLICY_VERSION=rank-v1
DECISION_FEATURE_PREFERENCE_WEIGHT=1.0
DECISION_MAX_CANDIDATES=12
DECISION_MAX_COMPARISON_ROWS=12
