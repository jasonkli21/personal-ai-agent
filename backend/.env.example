# Use a local provider setting during development; never commit real secrets.
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
AI_API_KEY=
# Phase 18 account-specific attestations stay off until independently reviewed.
# Strict-free admission also requires exact per-model limits; leave unset until preflight.
# GEMINI_ENDPOINT_CONTEXT_LIMIT_TOKENS=...
# GEMINI_ENDPOINT_OUTPUT_LIMIT_TOKENS=...
# GEMINI_EMBEDDING_CONTEXT_LIMIT_TOKENS=...
GEMINI_ACCOUNT_SCOPE_ID=
GEMINI_CREDENTIAL_SCOPE_ID=gemini-primary-key
GEMINI_FREE_TIER_VERIFIED=false
GEMINI_PRIVACY_APPROVED=false
GEMINI_PRIVACY_MAX_SENSITIVITY=public
GEMINI_PREFLIGHT_REFERENCE=
GEMINI_COUNTER_COMPATIBILITY_VERIFIED=false
GEMINI_COUNTER_PREFLIGHT_REFERENCE=
GEMINI_STRUCTURED_OUTPUT_VERIFIED=false
GEMINI_STRUCTURED_SCHEMA_IDS=[]
GEMINI_QUOTA_MEMBERSHIP_VERIFIED=false
GEMINI_QUOTA_BUCKETS=[]
# Phase 17 reference adapters are disabled until account/model-specific free-tier,
# privacy, and endpoint-preflight evidence has been reviewed and recorded.
GROQ_ADAPTER_ENABLED=false
GROQ_MODEL=
GROQ_API_KEY=
GROQ_FREE_TIER_VERIFIED=false
GROQ_PRIVACY_APPROVED=false
GROQ_PRIVACY_MAX_SENSITIVITY=public
# Set after preflighting this exact account/model profile.
# GROQ_ENDPOINT_CONTEXT_LIMIT_TOKENS=...
# GROQ_ENDPOINT_OUTPUT_LIMIT_TOKENS=...
GROQ_ACCOUNT_SCOPE_ID=
GROQ_CREDENTIAL_SCOPE_ID=groq-primary-key
GROQ_QUOTA_MEMBERSHIP_VERIFIED=false
GROQ_QUOTA_BUCKETS=[]
GROQ_APPROVED_MODEL_ALIASES=[]
GROQ_STRUCTURED_SCHEMA_IDS=[]
GROQ_STRUCTURED_OUTPUT_VERIFIED=false
GROQ_PREFLIGHT_REFERENCE=
CLOUDFLARE_ADAPTER_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_FREE_TIER_VERIFIED=false
CLOUDFLARE_PRIVACY_APPROVED=false
CLOUDFLARE_PRIVACY_MAX_SENSITIVITY=public
# Set after preflighting this exact account/model profile.
# CLOUDFLARE_ENDPOINT_CONTEXT_LIMIT_TOKENS=...
# CLOUDFLARE_ENDPOINT_OUTPUT_LIMIT_TOKENS=...
CLOUDFLARE_CREDENTIAL_SCOPE_ID=cloudflare-primary-token
CLOUDFLARE_QUOTA_MEMBERSHIP_VERIFIED=false
CLOUDFLARE_QUOTA_BUCKETS=[]
CLOUDFLARE_APPROVED_MODEL_ALIASES=[]
CLOUDFLARE_STRUCTURED_SCHEMA_IDS=[]
CLOUDFLARE_STRUCTURED_OUTPUT_VERIFIED=false
CLOUDFLARE_PREFLIGHT_REFERENCE=
# JSON array of complete EndpointProfile facts for explicitly configured endpoints.
# Entries contain symbolic credential references, never credential values.
INFERENCE_ADDITIONAL_ENDPOINT_PROFILES=[]
APP_ENVIRONMENT=local
GCP_PROJECT_ID=
PERSISTENCE_LOCAL_POSTGRES_DSN=postgresql://personal_ai:personal_ai_local_only@127.0.0.1:54329/personal_ai
PERSISTENCE_LOCAL_DYNAMODB_ENDPOINT=http://127.0.0.1:8000
P10_CLOUD_ADAPTERS_CONFIGURED=false
P10_NEON_RUNTIME_DSN=
P10_NEON_POOL_MAX_SIZE=4
P10_DYNAMODB_REGION=us-east-1
P10_DYNAMODB_TABLE_NAME=personal-ai-runtime-v1
P10_DYNAMODB_ROLE_ARN=
P10_DYNAMODB_IDENTITY_TOKEN_AUDIENCE=
AUTH_MODE=development
AUTH_REQUIRED=false
AUTH_ISSUER=https://accounts.google.com
AUTH_AUDIENCE=
AUTH_ALLOWED_EMAILS=[]
AUTH_HOSTED_DOMAIN=
AUTH_RECENT_TOKEN_SECONDS=300
WORKER_PUSH_AUTH_REQUIRED=false
WORKER_PUSH_AUDIENCE=
WORKER_PUSH_SERVICE_ACCOUNT=
WORKER_MAINTENANCE_AUTH_REQUIRED=false
WORKER_MAINTENANCE_AUDIENCE=
WORKER_MAINTENANCE_SERVICE_ACCOUNT=
REQUEST_TIMEOUT_SECONDS=30
# Application ceilings; verify compatibility whenever AI_MODEL changes.
MAX_CONTEXT_TOKENS=32768
MAX_RESPONSE_TOKENS=4096
CONTEXT_SAFETY_MARGIN_TOKENS=1024
SUMMARY_TRIGGER_TOKENS=12000
MAX_SUMMARY_TOKENS=2048
CONTEXT_INSPECTION_ENABLED=false
# JSON allowlist. Production/staging must list exact HTTPS origins; wildcards are rejected.
ALLOWED_ORIGINS=["http://localhost:3000"]
OBSERVABILITY_REDACTION_VERSION=redaction-v1
API_RATE_LIMIT_PER_MINUTE=60
PROVIDER_CALLS_PER_DAY_LIMIT=100
INPUT_TOKENS_PER_DAY_LIMIT=200000
CHAT_KILL_SWITCH_ENABLED=false
RESEARCH_KILL_SWITCH_ENABLED=false
WORKER_KILL_SWITCH_ENABLED=false
EXTERNAL_PROVIDERS_KILL_SWITCH_ENABLED=false
MAINTENANCE_ENABLED=false
MAINTENANCE_BATCH_SIZE=40
EXPORT_ENABLED=false
DELETION_ENABLED=false
DELETION_GRACE_PERIOD_DAYS=7
EXPORT_MAX_RECORDS=5000
EXPORT_MAX_BYTES=8388608

# Phase 3: enable only after reviewing provider-data suitability.
MEMORY_ENABLED=false
MEMORY_EXTRACTION_ENABLED=false
MEMORY_INSPECTION_ENABLED=false
MEMORY_EMBEDDING_MODEL=gemini-embedding-001
MEMORY_EMBEDDING_DIMENSIONS=768
MEMORY_EMBEDDING_BATCH_SIZE=8
MEMORY_MAX_CANDIDATES_PER_TURN=4
MEMORY_RETRIEVAL_CANDIDATE_LIMIT=20
MEMORY_RETRIEVAL_LIMIT=4
MEMORY_MIN_SIMILARITY=0.8
MEMORY_MAX_CONTEXT_TOKENS=512
MEMORY_TIMEOUT_SECONDS=5
# JSON array of additional denied terms, e.g. ["synthetic-private-term"]
MEMORY_SENSITIVE_TERMS=[]

# Phase 4 experiment controls. Lifecycle and inspection gates stay off by default.
MEMORY_EXPERIMENT_VARIANT=fixed
MEMORY_SCORING_POLICY_VERSION=score-v1
MEMORY_SCORE_SIMILARITY_WEIGHT=0.50
MEMORY_SCORE_IMPORTANCE_WEIGHT=0.15
MEMORY_SCORE_RECENCY_WEIGHT=0.15
MEMORY_SCORE_FREQUENCY_WEIGHT=0.10
MEMORY_SCORE_CONFIDENCE_WEIGHT=0.10
MEMORY_RECENCY_HALF_LIFE_DAYS=90
MEMORY_CONSOLIDATION_ENABLED=false
MEMORY_CONSOLIDATION_MAX_SOURCES=4
MEMORY_CONTRADICTION_AUTOMATION_ENABLED=false
MEMORY_FORGETTING_ENABLED=false
MEMORY_LIFECYCLE_WORKER_ENABLED=false
MEMORY_LIFECYCLE_INSPECTION_ENABLED=false
MEMORY_LIFECYCLE_TOPIC=personal-ai-async
MEMORY_JOB_MAX_ATTEMPTS=3
MEMORY_JOB_EXECUTION_SECONDS=30
MEMORY_JOB_LEASE_SECONDS=60
MEMORY_JOB_CANDIDATE_LIMIT=40

# Phase 5. Real search requires explicit storage/AI-use rights; see its guide.
RESEARCH_STORAGE=postgres
RESEARCH_ENABLED=false
RESEARCH_INSPECTION_ENABLED=false
RESEARCH_SEARCH_ADAPTER=fake
RESEARCH_PLANNER=deterministic
RESEARCH_RERANKER=deterministic
RESEARCH_PROVIDER_STORAGE_APPROVED=false
RESEARCH_API_KEY=
RESEARCH_MAX_QUERIES=1
RESEARCH_MAX_SOURCES=8
RESEARCH_MAX_RESPONSE_BYTES=131072
RESEARCH_MAX_REDIRECTS=0
RESEARCH_MAX_CONCURRENCY=1
RESEARCH_ATTEMPT_LIMIT=2
RESEARCH_EVIDENCE_TTL_GENERAL_SECONDS=86400
RESEARCH_EVIDENCE_TTL_CURRENT_SECONDS=3600
RESEARCH_MAX_EVIDENCE_CONTEXT_TOKENS=4096
RESEARCH_TIMEOUT_SECONDS=30
RESEARCH_PROVIDER_TIMEOUT_SECONDS=10
RESEARCH_MIN_REQUEST_INTERVAL_SECONDS=1
# Phase 8: explicit opt-in; iterative runs remain disabled by default.
ITERATIVE_RESEARCH_ENABLED=false
ITERATIVE_PROGRESS_ENABLED=false
ITERATIVE_RESEARCH_POLICY_VERSION=iterative-research-policy-v1
ITERATIVE_MAX_ITERATIONS=3
ITERATIVE_MAX_QUERIES=3
ITERATIVE_MAX_SOURCES=12
ITERATIVE_MAX_ELAPSED_SECONDS=90
ITERATIVE_MAX_TOKENS=16000
ITERATIVE_MAX_PROVIDER_COST_USD=0.05
ITERATIVE_ALLOWED_DOMAINS=["example.org"]
ITERATIVE_SYNTHESIS_RESERVE_TOKENS=4096
ITERATIVE_SYNTHESIS_RESERVE_SECONDS=20
ITERATIVE_SEARCH_COST_USD=0.005
ITERATIVE_SYNTHESIS_COST_USD=0.005
DECISION_ENABLED=false
DECISION_INSPECTION_ENABLED=false
ENTITY_RESOLUTION_POLICY_VERSION=resolve-v2
ENTITY_MATCH_THRESHOLD=0.9
DECISION_CONSTRAINT_POLICY_VERSION=constraint-v1
DECISION_RANKING_POLICY_VERSION=rank-v1
DECISION_FEATURE_PREFERENCE_WEIGHT=1.0
DECISION_MAX_CANDIDATES=12
DECISION_MAX_COMPARISON_ROWS=12

# Phase 7: synthetic domain fixtures work only when their individual gates are enabled.
# Keep providers on fake; see ADRs 0013-0015 before configuring a public source.
TRAVEL_ENABLED=false
SHOPPING_ENABLED=false
DOMAIN_INSPECTION_ENABLED=false
DOMAIN_MAX_RESULTS=8
DOMAIN_MAX_COMPARISON_ROWS=12
DOMAIN_MAX_RESPONSE_BYTES=131072
DOMAIN_PROVIDER_TIMEOUT_SECONDS=10
TRAVEL_PLACES_ADAPTER=fake
TRAVEL_PROVIDER_POLICY_APPROVED=false
TRAVEL_OSM_CONTACT_EMAIL=
TRAVEL_OSM_USER_AGENT="PersonalAISystem/0.1"
TRAVEL_MIN_REQUEST_INTERVAL_SECONDS=1
TRAVEL_PLACE_TTL_SECONDS=604800
SHOPPING_PRODUCTS_ADAPTER=fake
SHOPPING_PROVIDER_POLICY_APPROVED=false
SHOPPING_OFF_USER_AGENT=
SHOPPING_OFF_BASE_URL=https://world.openfoodfacts.net
SHOPPING_MIN_REQUEST_INTERVAL_SECONDS=4
SHOPPING_PRODUCT_TTL_SECONDS=2592000

# Proposed travel capability; keep both gates off until contract review.
ITINERARY_PROPOSALS_ENABLED=false
ITINERARY_PROPOSAL_GENERATOR=fake
ITINERARY_PROPOSAL_PROVIDER_ENABLED=false
ITINERARY_PROPOSAL_STORAGE=postgres
ITINERARY_PROPOSAL_TIMEOUT_SECONDS=35
ITINERARY_PROPOSAL_MAX_INPUT_TOKENS=4096
ITINERARY_PROPOSAL_MAX_OUTPUT_TOKENS=2048
ITINERARY_PROPOSAL_MAX_RESPONSE_BYTES=32768

# Local candidate only; keep both booking extraction gates off by default.
BOOKING_EXTRACTIONS_ENABLED=false
BOOKING_EXTRACTION_GENERATOR=fake
BOOKING_EXTRACTION_PROVIDER_ENABLED=false
BOOKING_EXTRACTION_STORAGE=postgres
BOOKING_EXTRACTION_TIMEOUT_SECONDS=30
BOOKING_EXTRACTION_MAX_INPUT_TOKENS=8192
BOOKING_EXTRACTION_MAX_OUTPUT_TOKENS=2048
